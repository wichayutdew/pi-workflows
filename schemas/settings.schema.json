{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pi workflows settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "allowProjectWorkflows": {
      "type": "boolean",
      "default": false
    },
    "permissionCeiling": {
      "$ref": "workflow.schema.json#/$defs/permissionCeiling"
    }
  }
}
